# Chave de API do Google Cloud para o localizador de leads
# Obtenha sua chave no console do Google Cloud e ative a "Places API"
# Renomeie este arquivo para '.env' e insira sua chave abaixo:
GOOGLE_API_KEY=AIzaSyDS5vF89dbKFroI1wpIQVDG3lfLydYfhaY

# Credenciais de conexão do Supabase (PostgreSQL)
SUPABASE_URL=https://sua-url-do-supabase.supabase.co
SUPABASE_KEY=sua-anon-ou-service-role-key
